# --- Database (optional) ----------------------------------------------------
# Unset (default): the app runs in DEMO MODE — every page reads from the
# realistic in-memory dataset in lib/samai/demo-data.ts, and auth is
# skipped entirely (there's no real account system behind demo data).
# Zero setup needed.
#
# Set: SamAIClient (lib/samai/client.ts) switches to querying Postgres via
# Prisma, AND middleware.ts starts requiring a real signed-in session
# (Auth.js) to reach any dashboard route.
#
#   1. createdb samai_control_plane   (or any Postgres 14+ instance)
#   2. npm install                     (postinstall runs `prisma generate`)
#   3. npx prisma migrate deploy       (applies prisma/migrations/)
#   4. npm run db:seed                 (loads the dataset + 4 demo accounts)
#   5. npm run dev, then sign in at /login
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/samai_control_plane"

# Required alongside DATABASE_URL — Auth.js signs session JWTs with this.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=94984kjjbhbjbhjbjnkjn

# --- Model provider (optional) ----------------------------------------------
# Unset (default): triggerRun() refuses instead of making a live model call —
# every other page still works fully (against demo data or Postgres, per
# DATABASE_URL above). Set this to wire up real samai-sdk runs.
ANTHROPIC_API_KEY=

# Optional, if you also wire up other providers in lib/samai/client.ts:
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
